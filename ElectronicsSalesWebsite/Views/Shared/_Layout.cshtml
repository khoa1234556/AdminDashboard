<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script>
        (function () {
            document.documentElement.setAttribute("data-bs-theme", localStorage.getItem("theme") || "light");
        })();
    </script>
    <title>@ViewData["Title"] - Electronics Sales Website</title>
    
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/css/site.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/index.css">
    

</head>
<body>
    <header class="p-3 d-flex justify-content-between">
        <div>
            <a class="h4" asp-controller="Home" asp-action="Index">DASHBOARD</a>
        </div>
        <div class="d-flex justify-content-end">
            <!-- From Uiverse.io by JkHuger -->
            <label for="theme" class="theme">
                <span class="theme__toggle-wrap">
                    <input id="theme" class="theme__toggle" type="checkbox" name="theme" value="dark" onclick="toggleTheme()">
                    <span class="theme__fill"></span>
                    <span class="theme__icon">
                        <span class="theme__icon-part"></span>
                        <span class="theme__icon-part"></span>
                        <span class="theme__icon-part"></span>
                        <span class="theme__icon-part"></span>
                        <span class="theme__icon-part"></span>
                        <span class="theme__icon-part"></span>
                        <span class="theme__icon-part"></span>
                        <span class="theme__icon-part"></span>
                        <span class="theme__icon-part"></span>
                    </span>
                </span>
            </label>
            <div id="cover-sub-info" style="display: none;"></div>
            <div id="nameUser" class="d-flex align-items-center me-1">
                <label class="px-3">ADMIN</label>
                <img class="rounded-circle" id="avatar" src="~/image/avatar/User.png" alt="Alternate Text" />
 
                <div id="sub-info" style="display: none;">
                    <ul>
                        <li>Thông tin</li>
                        <li>Cài đặt</li>
                        <li>Đăng xuất</li>
                    </ul>
                </div>
            </div>

            
        </div> 
    </header>
    <div class="d-flex main">
        <div class="nav-left mb-5 pt-4 hidden" id="leftNav">
            <ul class="navbar-nav">
                <li class="nav-item d-none d-sm-block">
                    <button class="right button" id="closeMenu">
                        <i id="icon" class="fas fa-bars menu-icon"></i>
                    </button>
                </li>
                <li class="nav-item ">
                    <a class="nav-link p-2 d-flex flex-row" asp-controller="Home" asp-action="Index">
                        <i class="fa-solid fa-house"></i>
                        <label>Home</label></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link p-2 d-flex flex-row" data-bs-toggle="collapse" href="#collapseExample" aria-controls="collapseExample">
                        <i class="fa-solid fa-user"></i>
                        <label>Account</label>
                        <i class="fa-solid fa-sort-down"></i>
                    </a>
                    <div class="nav-item collapse" id="collapseExample">
                        <a class="nav-link nav-item_1 d-flex flex-row">
                            <i class="fas fa-spinner fa-spin"></i>
                            <label>Item 1</label>
                        </a>
                        <a class="nav-link nav-item_1 d-flex flex-row">
                            <i class="fas fa-spinner fa-spin"></i>
                            <label>Item 2</label>
                        </a><a class="nav-link nav-item_1 d-flex flex-row">
                            <i class="fas fa-spinner fa-spin"></i>
                            <label>Item 3</label>
                        </a>
                    </div>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link p-2 d-flex flex-row" asp-controller="Home" asp-action="Contact">
                        <i class="fa-solid fa-medal"></i>
                        <label>Contact</label>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link p-2 d-flex flex-row" asp-controller="Home" asp-action="About">
                        <i class="fa-solid fa-user"></i>
                        <label>About</label>
                    </a>
                </li>

            </ul>
        </div>
        <div class="flex-fill mx-4">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>
    

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="~/js/index.js"></script>
    <script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
</body>
</html>
